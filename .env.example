# ML Sentry settings. Copy this file to .env and fill in your own values.
# .env holds your secrets and is never committed to Git.

# ---------- Where your model's metrics live (your own MLflow) ----------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=california-housing-demo

# ---------- What to watch ----------
# Metric names exactly as your model logs them to MLflow, comma separated
METRICS=rmse,r2,rmse_gap,max_psi
# For every metric give <NAME>_MAX (alert when it goes above)
# and/or <NAME>_MIN (alert when it goes below)
RMSE_MAX=0.60
R2_MIN=0.70
RMSE_GAP_MAX=0.20
MAX_PSI_MAX=0.20
# How often to check MLflow for new results, in seconds
POLL_INTERVAL_SECONDS=10
# Where ML Sentry keeps its metric history
SQLITE_PATH=state/mlsentry.db

# ---------- The agent (LLM that judges severity) ----------
# Groq is tried first, then a local Ollama model, then simple built-in rules
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---------- Alerts ----------
# slack, telegram or console (comma separate to use several)
ALERT_CHANNEL=console
SLACK_WEBHOOK_URL=your-slack-webhook-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# ---------- Only used when ML Sentry runs inside Docker ----------
# Inside a container "localhost" means the container itself,
# so these point back to your computer instead
DOCKER_MLFLOW_TRACKING_URI=http://host.docker.internal:5000
DOCKER_OLLAMA_HOST=http://host.docker.internal:11434

# ---------- Only used by the demo in examples/california_housing ----------
DEMO_TARGET_COL=MedHouseVal
DEMO_GROUP_COL=region
DEMO_BATCH_SIZE=500
